; Engine configuration file.
; Open in Godot 4.7+; do not edit manually.

config_version=5

[application]

config/name="anabios"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://scripts/game_config.gd"
DebugCapture="*res://scripts/debug_capture.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
; Backdrop behind the world (visible past the 3x3 terrain wrap tiles, and on a
; scenario that fails to load). Godot's stock mid-grey clashed hard with the
; near-black instrument HUD; this is the same deep teal-black the panels use.
environment/defaults/default_clear_color=Color(0.027, 0.043, 0.055, 1)
