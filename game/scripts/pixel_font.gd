extends RefCounted
# 5x7 pixel HUD font (the reference boards set their HUD in crisp pixel
# text). Ninety-five printable ASCII glyphs authored as 5x9 row strings
# (rows 0-6 above the baseline, rows 7-8 descenders), packed at runtime into
# a small atlas and handed to Godot as a fixed-size bitmap FontFile with
# integer scaling, so every label and canvas string in the theme renders
# pixel-exact at 9 px per line (18 px at the brand size) with no
# antialiasing. build() caches the font; nothing here touches the disk.

const CELL_W := 6  # 5 px glyph + 1 px gap
const CELL_H := 9
const GLYPH_W := 5
const ASCENT := 7
const DESCENT := 2
const ATLAS_COLS := 16

