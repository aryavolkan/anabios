static var _font: FontFile = null


# The glyph atlas: every glyph in code-point order on an ATLAS_COLS grid of
# CELL_W x CELL_H cells, white on transparent.
static func atlas_image() -> Image:
	var chars: Array = GLYPHS.keys()
	chars.sort_custom(func(a, b): return a.unicode_at(0) < b.unicode_at(0))
	var rows: int = int(ceil(float(chars.size()) / float(ATLAS_COLS)))
	var img := Image.create(ATLAS_COLS * CELL_W, rows * CELL_H, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for i in chars.size():
		var cx: int = (i % ATLAS_COLS) * CELL_W
		var cy: int = int(i / float(ATLAS_COLS)) * CELL_H
		var grid: Array = GLYPHS[chars[i]]
		for y in CELL_H:
			var row: String = grid[y]
			for x in GLYPH_W:
				if row[x] == "#":
					img.set_pixel(cx + x, cy + y, Color.WHITE)
	return img


static func build() -> FontFile:
	if _font != null:
		return _font
	var chars: Array = GLYPHS.keys()
	chars.sort_custom(func(a, b): return a.unicode_at(0) < b.unicode_at(0))
	var font := FontFile.new()
	font.fixed_size = CELL_H
	font.fixed_size_scale_mode = 1  # TextServer.FIXED_SIZE_SCALE_INTEGER
	font.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	font.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	font.hinting = TextServer.HINTING_NONE
	font.generate_mipmaps = false
	var size := Vector2i(CELL_H, 0)
	font.set_texture_image(0, size, 0, atlas_image())
	font.set_cache_ascent(0, CELL_H, float(ASCENT))
	font.set_cache_descent(0, CELL_H, float(DESCENT))
	for i in chars.size():
		var glyph: int = (chars[i] as String).unicode_at(0)
		var cx: int = (i % ATLAS_COLS) * CELL_W
		var cy: int = int(i / float(ATLAS_COLS)) * CELL_H
		font.set_glyph_texture_idx(0, size, glyph, 0)
		font.set_glyph_uv_rect(0, size, glyph, Rect2(cx, cy, GLYPH_W, CELL_H))
		font.set_glyph_size(0, size, glyph, Vector2(GLYPH_W, CELL_H))
		font.set_glyph_offset(0, size, glyph, Vector2(0, -ASCENT))
		font.set_glyph_advance(0, CELL_H, glyph, Vector2(CELL_W, 0))
	_font = font
	return font
