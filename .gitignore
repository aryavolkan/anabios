# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Godot
.godot/
.import/
export.cfg
export_presets.cfg
*.translation
*.import

# Godot editor addons are local tooling (Fennara MCP), not viewer code —
# the anabios gdextension loads its built lib from /target, not from here.
/game/addons/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo

# Brainstorm working files
.superpowers/

# Local runs
/runs/
*.codex.db
*.codex.db-wal
*.codex.db-shm

# Profiling artifacts
*.flamegraph.svg
trace-*.json

# Claude Code (worktrees, session state)
.claude/

# Fennara MCP: per-machine setup artifacts (generated agent guidance + skills)
# and scratch (runtime probes, screenshot workers, tool logs). The addon
# itself is covered by /game/addons/ above.
.agents/
/game/AGENTS.md
/game/.fennara/

# Godot resource UID caches (regenerated on import)
*.gd.uid
*.gdshader.uid

# Web frontend (web/): generated at build time by scripts/web.sh — the wasm
# module, the vendored three.js runtime, the staged scenario copies + manifest,
# and the staged replay. package-lock.json is kept (pins three).
/web/node_modules/
/web/vendor/
/web/wasm/
/web/scenarios/
/web/replays/
